# =============================================================================
# MindLedger — Staging Environment Overrides
# =============================================================================
#
# This file documents variables that differ from .env.example in staging.
# Do NOT commit actual secrets. In CI/CD, set these as masked GitLab variables
# (Settings → CI/CD → Variables) and inject them with envsubst before applying
# k8s/base/secrets.yaml and k8s/base/configmap.yaml.
#
# Usage (local staging compose):
#   cp .env.staging.example .env.staging
#   # fill in real values, then:
#   docker compose --env-file .env.staging up -d
#
# =============================================================================

# ── Django ─────────────────────────────────────────────────────────────────────
DEBUG=False
# Generate: python -c "import secrets; chars='abcdefghijklmnopqrstuvwxyz0123456789!@#$%^&*(-_=+)'; print(''.join(secrets.choice(chars) for _ in range(50)))"
SECRET_KEY=STAGING_SECRET_KEY_PLACEHOLDER

ALLOWED_HOSTS=staging.example.com,api-staging.example.com
CORS_ALLOWED_ORIGINS=https://staging.example.com

# ── Encryption ─────────────────────────────────────────────────────────────────
# CRITICAL: generate once and store in GitLab CI variable — never rotate after
# the staging DB contains encrypted data.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=STAGING_ENCRYPTION_KEY_PLACEHOLDER

# ── Database ───────────────────────────────────────────────────────────────────
DB_HOST=db
DB_PORT=39102
DB_NAME=mindledger_staging
DB_USER=mindledger_staging
DB_PASSWORD=STAGING_DB_PASSWORD_PLACEHOLDER

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=STAGING_REDIS_PASSWORD_PLACEHOLDER

# ── MinIO ──────────────────────────────────────────────────────────────────────
MINIO_ROOT_USER=mindledger-staging
MINIO_ROOT_PASSWORD=STAGING_MINIO_PASSWORD_PLACEHOLDER
MINIO_BUCKET_NAME=mindledger-staging
MINIO_ENDPOINT=minio:9000
MINIO_EXTERNAL_ENDPOINT=staging.example.com:39105
MINIO_USE_SSL=false

# ── Security (HTTPS required in staging) ──────────────────────────────────────
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
# Start with a short value; increase to 31536000 once HTTPS is verified.
SECURE_HSTS_SECONDS=300
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=False
SECURE_PROXY_SSL_HEADER=True

# ── Logging ────────────────────────────────────────────────────────────────────
LOG_FORMAT=json
LOG_LEVEL=INFO

# ── Superuser (seeded on first migrate) ───────────────────────────────────────
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@staging.example.com
DJANGO_SUPERUSER_PASSWORD=STAGING_SUPERUSER_PASSWORD_PLACEHOLDER

# ── Backup ─────────────────────────────────────────────────────────────────────
BACKUP_ENCRYPTION_KEY=STAGING_BACKUP_ENCRYPTION_KEY_PLACEHOLDER
BACKUP_KEY_VERSION=v1
BACKUP_MINIO_BUCKET=mindledger-staging-backups
BACKUP_CRON=0 3 * * *
KEEP_DAILY=3
KEEP_WEEKLY=2
KEEP_MONTHLY=1

# ── Ports ─────────────────────────────────────────────────────────────────────
API_PORT=39100
FRONTEND_PORT=39101
MINIO_PORT=39105
MINIO_CONSOLE_PORT=39106
REDIS_PORT=39103
DB_PORT=39102

# ── Frontend ───────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=https://staging.example.com

# ── Gunicorn ───────────────────────────────────────────────────────────────────
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=120
