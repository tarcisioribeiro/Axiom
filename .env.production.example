# =============================================================================
# MindLedger — Production Environment Overrides
# =============================================================================
#
# This file documents variables that differ from .env.example in production.
# Do NOT commit actual secrets. All values marked _PLACEHOLDER must be set as
# masked, protected GitLab CI variables (Settings → CI/CD → Variables).
#
# Apply to Kubernetes:
#   # Export all variables as shell vars, then:
#   envsubst < k8s/base/secrets.yaml   | kubectl apply -n mindledger -f -
#   envsubst < k8s/base/configmap.yaml | kubectl apply -n mindledger -f -
#
# =============================================================================

# ── Django ─────────────────────────────────────────────────────────────────────
DEBUG=False
# Generate: python -c "import secrets; chars='abcdefghijklmnopqrstuvwxyz0123456789!@#$%^&*(-_=+)'; print(''.join(secrets.choice(chars) for _ in range(50)))"
SECRET_KEY=PRODUCTION_SECRET_KEY_PLACEHOLDER

ALLOWED_HOSTS=example.com,api.example.com
CORS_ALLOWED_ORIGINS=https://example.com

# ── Encryption ─────────────────────────────────────────────────────────────────
# CRITICAL: generate once at first deploy and never change.
# Changing this key makes all encrypted fields unreadable.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=PRODUCTION_ENCRYPTION_KEY_PLACEHOLDER

# ── Database ───────────────────────────────────────────────────────────────────
DB_HOST=db
DB_PORT=5432
DB_NAME=mindledger_db
DB_USER=mindledger
DB_PASSWORD=PRODUCTION_DB_PASSWORD_PLACEHOLDER

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=PRODUCTION_REDIS_PASSWORD_PLACEHOLDER

# ── MinIO ──────────────────────────────────────────────────────────────────────
MINIO_ROOT_USER=mindledger
MINIO_ROOT_PASSWORD=PRODUCTION_MINIO_PASSWORD_PLACEHOLDER
MINIO_BUCKET_NAME=mindledger
MINIO_ENDPOINT=minio:9000
MINIO_EXTERNAL_ENDPOINT=example.com:9000
MINIO_USE_SSL=true

# ── Security (full HTTPS hardening) ───────────────────────────────────────────
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
# 1 year after staging has been stable with HSTS.
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
SECURE_PROXY_SSL_HEADER=True

# ── Logging ────────────────────────────────────────────────────────────────────
LOG_FORMAT=json
LOG_LEVEL=WARNING

# ── Superuser (seeded once on first apply) ────────────────────────────────────
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=PRODUCTION_SUPERUSER_PASSWORD_PLACEHOLDER

# ── Backup ─────────────────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
BACKUP_ENCRYPTION_KEY=PRODUCTION_BACKUP_ENCRYPTION_KEY_PLACEHOLDER
BACKUP_KEY_VERSION=v1
BACKUP_MINIO_BUCKET=mindledger-backups
# 02:00 BRT daily
BACKUP_CRON=0 2 * * *
# GFS policy — production retains more history than staging
KEEP_DAILY=7
KEEP_WEEKLY=4
KEEP_MONTHLY=3

# ── Ports (Kubernetes: handled by Services/Ingress, not host ports) ────────────
API_PORT=39100
FRONTEND_PORT=39101

# ── Frontend ───────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=https://example.com

# ── Gunicorn ───────────────────────────────────────────────────────────────────
GUNICORN_WORKERS=4
GUNICORN_TIMEOUT=120

# ── Sentry (optional error tracking) ──────────────────────────────────────────
SENTRY_DSN=PRODUCTION_SENTRY_DSN_PLACEHOLDER
