# ============================================================================
# AXIOM - Variáveis de Ambiente (Exemplo)
# ============================================================================
# Copie este arquivo para .env e preencha com seus valores:
#   cp .env.example .env
# Ou use o script interativo:
#   ./setup-env.sh
# ============================================================================

# ============================================================================
# DATABASE (PostgreSQL)
# ============================================================================
DB_HOST=db
DB_PORT=39102
DB_NAME=axiom_db
DB_USER=axiom_user
DB_PASSWORD=your_secure_db_password_here

# ============================================================================
# DJANGO (Backend API)
# ============================================================================
# Gerar com: python -c "import secrets; chars='abcdefghijklmnopqrstuvwxyz0123456789!@#$%^&*(-_=+)'; print(''.join(secrets.choice(chars) for _ in range(50)))"
SECRET_KEY=your-50-character-random-django-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:39101,http://127.0.0.1:39101

# ============================================================================
# DJANGO SUPERUSER
# ============================================================================
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=your_secure_superuser_password_here

# ============================================================================
# ENCRYPTION
# ============================================================================
# CRÍTICO: Nunca altere esta chave após o primeiro uso.
# Todos os dados criptografados no banco ficarão ilegíveis se a chave mudar.
# Gerar com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your-44-character-fernet-base64-key-here=

# ============================================================================
# LOGGING
# ============================================================================
LOG_FORMAT=json
LOG_LEVEL=INFO

# ============================================================================
# APPLICATION PORTS
# ============================================================================
API_PORT=39100
FRONTEND_PORT=39101

# ============================================================================
# GUNICORN (Production Server)
# ============================================================================
GUNICORN_WORKERS=4
GUNICORN_TIMEOUT=120

# ============================================================================
# FRONTEND CONFIGURATION
# ============================================================================
VITE_API_BASE_URL=http://localhost:39100

# ============================================================================
# SECURITY SETTINGS
# In production (DEBUG=False + HTTPS): set all of these to True and
# SECURE_HSTS_SECONDS to a non-zero value (start with 300 in staging,
# then 31536000 once HTTPS is verified end-to-end).
# SECURE_PROXY_SSL_HEADER must be True when behind an SSL-terminating proxy.
# ============================================================================
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
SECURE_PROXY_SSL_HEADER=False

# ============================================================================
# BACKUP CONFIGURATION
# ============================================================================
BACKUP_DIR=./backups

# AES-256 passphrase used to encrypt pg_dump files before upload to MinIO.
# Rotate this key periodically using rekey-backups.sh (see apps/api/scripts/).
# When rotating: bump BACKUP_KEY_VERSION, keep the old value as
# BACKUP_ENCRYPTION_KEY_v<N> so historical backups remain decryptable.
# Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
BACKUP_ENCRYPTION_KEY=your-32-plus-char-random-passphrase-here

# Version label embedded in every backup filename (e.g. _kv1).
# Increment this (v2, v3, …) each time you rotate BACKUP_ENCRYPTION_KEY.
BACKUP_KEY_VERSION=v1

# Historical keys — add one entry per past rotation so verify-backup.sh and
# rekey-backups.sh can decrypt older archives.
# BACKUP_ENCRYPTION_KEY_V1=previous-passphrase-here

# Cron schedule for the db-backup service (default: 02:00 BRT daily).
# Standard cron syntax; runs in America/Sao_Paulo timezone.
BACKUP_CRON=0 2 * * *

# GFS (Grandfather-Father-Son) retention policy for local encrypted dumps.
# Backups older than all three windows are deleted automatically.
KEEP_DAILY=7       # keep the 7 most recent daily backups
KEEP_WEEKLY=4      # keep one backup per ISO week for the last 4 weeks
KEEP_MONTHLY=3     # keep one backup per month for the last 3 months

# MinIO bucket dedicated to database backups (separate from application media).
BACKUP_MINIO_BUCKET=axiom-backups

# ============================================================================
# MinIO / S3 Object Storage
# ============================================================================
MINIO_ROOT_USER=axiom
MINIO_ROOT_PASSWORD=your_secure_minio_password_here
MINIO_BUCKET_NAME=axiom
MINIO_ENDPOINT=minio:9000
MINIO_EXTERNAL_ENDPOINT=localhost:39105
MINIO_USE_SSL=false
MINIO_PORT=39105
MINIO_CONSOLE_PORT=39106

# ============================================================================
# REDIS
# ============================================================================
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
REDIS_PASSWORD=your_secure_redis_password_here

# ============================================================================
# EMAIL (Notification delivery)
# Set EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend for dev.
# ============================================================================
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=your-smtp-username@example.com
EMAIL_HOST_PASSWORD=your-smtp-password-here
DEFAULT_FROM_EMAIL=Axiom <noreply@axiom.app>
# Public URL shown in email links — set to your frontend origin
SITE_URL=http://localhost:39101

# ============================================================================
# DEVELOPMENT SETTINGS
# ============================================================================
ENABLE_DEBUG_TOOLBAR=False
SHOW_SQL_QUERIES=False
