    "jspdf": "4.2.1",
    "motion": "^13.1.0",
    "pdfjs-dist": "6.2.108",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-force-graph": "1.48.2",
    "react-hook-form": "7.83.0",
    "react-i18next": "17.0.11",
    "react-is": "19.2.8",
    "react-markdown": "10.1.0",
    "react-pdf": "10.4.1",
    "react-router": "8.3.0",
